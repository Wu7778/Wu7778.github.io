{
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {"api/index.js": {"includeFiles": "server.cjs", "maxDuration": 30}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index?route=:path*"}],
  "headers": [{"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "no-referrer"}]}]
}
